# HTTP listen address
ADDR=:8080

# PostgreSQL connection string
DATABASE_URL=postgres://kenosm:kenosm@localhost:5432/kenosm?sslmode=disable

# Master key used to encrypt stored secrets (upstream API keys, proxy passwords).
# Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# Optional: bearer key required on /api/v1/* and /proxy/*. Empty = unauthenticated.
# Generate one with: openssl rand -hex 32
# KENOSM_API_KEY=change-me

# Max concurrent swarm runs (default 1). Higher values allow parallel chat turns
# but they share the workspace, so agents can collide. Keep at 1 for safety.
# MAX_CONCURRENT_RUNS=1

# Max self-review rounds in "Polish" mode (default 5). Polish re-runs the swarm
# with the reviewer's feedback until the result is approved or the budget runs out.
# POLISH_MAX_ROUNDS=5

# Max agent tool-call iterations (turns) per subtask (default 50). Raise it for
# long multi-step tasks (e.g. visiting many sites); lower it to cap runaway agents.
# AGENT_MAX_ITERATIONS=50

# Directory holding the versioned design library (icons, templates, UI/UX
# database). Seeded into the workspace on startup and after a clear. Default "assets".
# ASSETS_DIR=assets

# Comma-separated tool modules disabled by default (files, shell, browser, desktop).
# Empty = enable every available module. Also togglable live in the Tools tab.
# DISABLED_MODULES=browser,desktop

# Graceful-shutdown timeout (server.Shutdown deadline). Default 30s.
# SHUTDOWN_TIMEOUT=30s

# Days to keep proxy request logs before periodic pruning. 0 disables pruning.
# LOG_RETENTION_DAYS=30

# Gemini model used by the swarm (agents are the enabled gateway services)
GEMINI_MODEL=gemini-3.8-flash

# Model used by the orchestrator/planner (default gemini-3.8-flash).
# ORCHESTRATOR_MODEL=gemini-3.8-flash

# Comma-separated fallback models tried in order on 429 RESOURCE_EXHAUSTED.
# AVAILABLE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest

# Optional: override the built-in model price table (USD per 1M tokens) used to
# compute API spend per model. Missing models fall back to a tier guessed from
# the name (pro / lite / flash).
# MODEL_PRICES={"gemini-3.8-flash":{"input":0.15,"output":0.6}}
